# ─── Uygulama ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Veritabanı (Docker Compose ile uyumlu) ──────────────────────
DATABASE_URL="postgresql://planora_user:planora_password@localhost:5432/planora_db?schema=public"

# ─── JWT ─────────────────────────────────────────────────────────
# Güçlü ve benzersiz secret key kullanın (min 32 karakter)
JWT_SECRET="BURAYA_GUCLU_VE_UZUN_BIR_SECRET_KEY_YAZIN"
JWT_REFRESH_SECRET="BURAYA_FARKLI_GUCLU_VE_UZUN_BIR_REFRESH_SECRET_YAZIN"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ─── Cold Start / Keep-alive ─────────────────────────────────────
# Production'da self-ping cron için (ör: https://planora-api.onrender.com)
SELF_URL=""
OPENAI_API_KEY="BURAYA_OPENAI_API_KEY_YAZIN"
